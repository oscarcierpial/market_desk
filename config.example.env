# Copy of config.env with every key and personal value blank. SETUP copies this
# to config.env on first run; config.env itself is never committed.
# Market desk settings. Edit, save, then double-click "2 - RUN".

# ---- Phone alerts -------------------------------------------------------------------------
# Install the free "ntfy" app, tap +, subscribe to a topic, and paste the same name here.
# Make it long and random; anyone who guesses it can read your alerts.
NTFY_TOPIC=

# Your name and email, so the SEC and other sites know who is requesting their feeds.
NEWS_UA=

# ---- Optional: AI explanations of the headlines (pick ONE option) ---------------------------
# Leave everything below commented out to run free, rules-only.
#
# Option 1, FREE: Google Gemini. Get a key at https://aistudio.google.com (Get API key). Don't
# enable billing on that Google project, or it stops being free. Remove the # from these 3 lines:
#LLM_PROVIDER=gemini
#LLM_API_KEY=
#BRIEF_MINUTES=30            # free tiers have daily limits; every 30 min is safer than 15
# If Gemini says the model isn't found, copy a current "Flash" model name from AI Studio here:
#LLM_MODEL=gemini-3.8-flash
#
# Option 2, FREE: Groq. Key from https://console.groq.com/keys
#LLM_PROVIDER=groq
LLM_API_KEY=
#BRIEF_MINUTES=30
#
# Option 3, PAID: Claude. Key from https://console.anthropic.com (set a monthly spend limit first).
#ANTHROPIC_API_KEY=
#BRIEF_MODEL=claude-haiku-4-5-20251001   # cheaper than the default Sonnet 5

# ---- Trading rules (defaults match the plan we built) --------------------------------------
BUDGET=500                 # max dollars per trade; options above this are skipped
MIN_ALERT_SCORE=6          # setups scoring 1-10; below this they're logged but not pushed
MIN_RR=1.5                 # minimum reward:risk to the first target
WATCHLIST_SIZE=20          # stocks the scanner watches minute by minute (plus SPY and QQQ)
MIN_DELTA=0.40
MAX_DELTA=0.75
MAX_SPREAD_PCT=0.05        # or $0.03, whichever is looser
MIN_PRICE=5
MIN_AVG_VOLUME=1000000
MIN_MARKET_CAP=1000000000
ZERO_DTE_CUTOFF=1430       # after 2:30 p.m., same-day expiries are skipped
# Alert windows (HHMM, Eastern). Setups outside these are still logged for the scorecard.
WINDOW1_START=945
WINDOW1_END=1130
WINDOW2_START=1330
WINDOW2_END=1530

# ---- Swing trades (30-60 DTE options, daily-chart setups) -----------------------------------
# Scans once a day at SWING_SCAN_TIME and returns the top 1-3 trades or NO TRADE.
SWING_ACCOUNT=1000            # account size used for position sizing
SWING_RISK_APLUS=0.15        # max share of the account at risk: A+ setups (final score 90+)
SWING_RISK_A=0.10            # A setups (85-90)
SWING_RISK_B=0.05            # B setups (below 85)
SWING_MIN_STOCK_SCORE=80     # no trade if the stock score is below this
SWING_MIN_OPTION_SCORE=75    # or the option score is below this
SWING_MIN_DTE=30
SWING_MAX_DTE=60             # preferred window; up to SWING_MAX_DTE_HIGH is allowed with a lower score
SWING_MAX_DTE_HIGH=75
SWING_MIN_DELTA=0.55
SWING_MAX_DELTA=0.75
SWING_MAX_SPREAD_PCT=0.05    # preferred bid/ask as a share of mid (scored); 10% is the hard limit
SWING_DEBIT_SPREADS=1        # 1 = also consider debit spreads (needed to fit most trades in a small account)
SWING_MIN_PRICE=20
SWING_MAX_HOLD=15            # trading days before a trade times out
SWING_STOP_FLOOR_ATR=1.0     # stops are at least this many ATRs from entry
SWING_SCAN_TIME=1000         # HHMM Eastern

#Alpaca
ALPACA_KEY_ID=
ALPACA_SECRET=


# ---- Day-trade backtest (history.py / daytrade_bt.py) ---------------------------------------
BT_YEARS=2                   # years of 1-minute history to download
BT_START=2016-03-07        # first day of history to download (overrides BT_YEARS)
BT_RISK_PER_TRADE=50         # dollars risked per trade in the report's $ view
BT_MAX_TRADES_PER_DAY=2      # "your rules" row: first N alerts each day
BT_OPTION_DELTA=0.50         # option estimate: assumed delta
BT_OPTION_COST=0.05          # option estimate: round-trip bid/ask per share ($0.05 = $5 per contract)
